# .env.example  —  Root project environment variables
# Copy to .env and fill in values. Never commit .env.

# OpenAI API key (Modules 3, 5, 6)
OPENAI_API_KEY=sk-...

# HuggingFace token (Module 1 diarization, Module 5 NLI)
HF_TOKEN=hf_...

# PostgreSQL connection (Module 8 / Prisma)
DATABASE_URL=postgresql://factcheck:factcheck@localhost:5432/factcheck

# WebSocket port overrides (optional — defaults shown)
M1_WS_PORT=8765
M2_WS_PORT=8766
M3_WS_PORT=8767
M4_WS_PORT=8768
M5_WS_PORT=8769
M6_WS_PORT=8770

