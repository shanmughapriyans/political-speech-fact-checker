# ============================================================
#  Module 1 — environment variables
#  Rename this file to .env and fill in your values.
#  NEVER commit .env to git — keep .env.example in the repo.
# ============================================================

# Hugging Face access token
# Get yours at: https://huggingface.co/settings/tokens
# The token must have READ access to:
#   - pyannote/speaker-diarization-3.1
#   - pyannote/segmentation-3.0
# Accept the model terms at those pages first, then paste your token below.
HF_TOKEN=hf_PASTE_YOUR_TOKEN_HERE
