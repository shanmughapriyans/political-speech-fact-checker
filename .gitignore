# ============================================================
# Fact Verification System — .gitignore
# ============================================================

# --- Secrets (NEVER commit) ---
.env
*.env
!*.env.example

# --- Python virtual environments ---
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# --- Large binary / audio files ---
*.wav
*.webm
*.mp3
*.mp4
*.m4a
*.ogg
*.flac
# Keep test tone if small (remove next line if you want it out too)
# test_tone.wav

# --- Model cache (HuggingFace, faster-whisper) ---
**/models/
**/.cache/
**/faster_whisper_models/
**/huggingface/
*.bin
*.safetensors
*.ot
*.onnx
*.pt
*.pth
*.ckpt

# --- BM25 / FAISS index files ---
*.pkl
*.index
*.npy
*.npz

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE & OS ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
.DS_Store
desktop.ini

# --- Logs ---
*.log
logs/
*.out

# --- Docker ---
.dockerignore

# --- Misc ---
*.bak
*.tmp
scratch/
